# Copy to .env and fill only what you connect. The app runs with NONE of these set.
# Photos-only mode needs no keys at all.

PORT=4173

# Google Drive connector (the user's Muse walks them through Google Cloud / Muse connector auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/connectors/google_drive/callback
GOOGLE_REFRESH_TOKEN=

# Spotify connector
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4173/api/connectors/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# Instagram: handled through the user's Muse Instagram connector, no keys stored here.
# The app only records consent + the handle in data/settings.json.
INSTAGRAM_HANDLE=

# Optional LLM for richer captions. Offline caption generation works without it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
